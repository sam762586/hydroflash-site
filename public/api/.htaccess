# --- API du logiciel HYDROFLASH ----------------------------------------------
# La racine du site refuse l'execution de tout PHP sauf exceptions nommees,
# et la preproduction demande un mot de passe. Ce dossier reouvre les deux,
# pour ces deux scripts seulement.

# 1. Lever la protection par mot de passe de la preproduction : le logiciel
#    appelle ce script sans pouvoir s'authentifier.
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Satisfy any
  Order deny,allow
  Allow from all
</IfModule>

# 2. Reautoriser le script d'envoi, refuse par la regle generale de la racine.
<Files "envoi.php">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Satisfy any
    Order deny,allow
    Allow from all
  </IfModule>
</Files>
# installer.php a été retiré du site le 20/11/2026, une fois la configuration écrite.
# Il était accessible sans mot de passe, et sa seule protection était l'existence du fichier
# config-mail.php : si ce fichier disparaissait (suppression, restauration de l'hébergement),
# le premier venu pouvait relancer l'installation, choisir le compte d'envoi et récupérer la clé.
# Pour reconfigurer l'envoi : le restaurer depuis l'historique git le temps de l'opération
#   git checkout 4233025 -- public/api/installer.php
# puis le supprimer de nouveau.

# 3. Le dossier lib/ ne doit jamais etre servi directement.
<FilesMatch "^(PHPMailer|SMTP|Exception)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "\.(log|txt|md|ini|bak)$|^config-mail\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
