---
/* Une page par commune couverte (src/data/communes.ts).
   Rien n'est inventé : population INSEE, zone tarifaire issue de la grille, bassin
   repris des pages départementales. Le texte varie selon le tissu urbain et la zone,
   pour que deux communes ne donnent pas la même page. */
import Base from '../../layouts/Base.astro';
import SousHero from '../../components/SousHero.astro';
import Faq from '../../components/Faq.astro';
import ContactCta from '../../components/ContactCta.astro';
import { FEUILLE_CONTENU } from '../../lib/feuilles';
import { services } from '../../data/services';
import { communes, voisines, memeDepartement, type Commune } from '../../data/communes';
import { entreprise as e } from '../../data/entreprise';
import { schemaEntreprise } from '../../lib/schema';
import zonesOrdi from '../../styles/pages/zones-ordinateur.css?url';
import zonesMobile from '../../styles/pages/zones-mobile.css?url';

export function getStaticPaths() {
  return communes.map((c) => ({ params: { commune: `${c.slug}-${c.cp}` }, props: { c } }));
}

const { c } = Astro.props as { c: Commune };
const dispo = e.disponibilite.libelle.replace(/(\d) /g, '$1 ');
const tel = `<a class="tel" href="${e.telephone.lien}">${e.telephone.affiche}</a>`;
const t = e.tarifs;
const departement = c.dep === '76' ? 'Seine-Maritime' : 'Eure';
/* « à Rouen » mais « au Havre » et « aux Andelys » : l'article se contracte. */
const aNom = c.nom.startsWith('Les ') ? `aux ${c.nom.slice(4)}`
  : c.nom.startsWith('Le ') ? `au ${c.nom.slice(3)}`
  : `à ${c.nom}`;
/* « de Rouen », « du Havre », « des Andelys ». */
const deNom = c.nom.startsWith('Les ') ? `des ${c.nom.slice(4)}`
  : c.nom.startsWith('Le ') ? `du ${c.nom.slice(3)}`
  : `de ${c.nom}`;
/* Même chose en tête de phrase : « À Rouen », « Au Havre ». */
const ANom = aNom.charAt(0).toUpperCase() + aNom.slice(1);
/** « la Seine-Maritime » / « l'Eure » — l'élision change selon le département. */
const leDep = c.dep === '76' ? 'la Seine-Maritime' : "l'Eure";
const pageDep = c.dep === '76' ? '/zones-intervention/seine-maritime-76/' : '/zones-intervention/eure-27/';
const hab = (c.population ?? 0).toLocaleString('fr-FR').replace(/ | /g, ' ');

/* Prix d'appel réels, repris de la grille. */
const manuel = t.prestations[0];
const hydro = t.prestations[1];
const eur = (v: number) => v.toLocaleString('fr-FR') + ' €';
/* Pour une commune à cheval, on annonce le prix le plus bas en précisant que la zone est confirmée. */
const prixManuel = c.zone === 'B' ? manuel.b! : manuel.a!;
const prixHydro = c.zone === 'B' ? hydro.b! : hydro.a!;

const libZone =
  c.zone === 'A' ? `zone A (${t.zones[0].libelle})`
  : c.zone === 'B' ? `zone B (${t.zones[1].libelle})`
  : 'à la limite des zones A et B';

/* Deux communes ne doivent jamais donner la même page : Google traite les pages
   clonées comme du contenu dupliqué et n'en garde qu'une. Le texte se compose donc
   de trois variantes par type d'habitat, choisies par le nom de la commune, plus
   une phrase propre au secteur géographique. Rien n'est inventé : ce sont des
   constats de métier, vrais partout, formulés différemment. */
const variantes: Record<Commune['tissu'], string[]> = {
  urbain: [
    `l'essentiel de nos interventions concerne des immeubles et des copropriétés : colonnes d'évacuation communes, branchements en sous-sol, regards de pied d'immeuble. Un bouchon de colonne se signale souvent par un refoulement chez le voisin du bas, pas chez celui qui l'a causé — d'où l'intérêt d'identifier le point exact avant de casser quoi que ce soit.`,
    `nous intervenons surtout en habitat collectif. Dans un immeuble, le bouchon est rarement là où l'eau remonte : il se forme plus bas, dans la colonne ou le collectif, et c'est le logement du rez-de-chaussée qui encaisse. Le passage caméra sert à situer le défaut avant d'engager des travaux.`,
    `les réseaux sont denses et souvent anciens : colonnes d'immeubles, branchements enterrés sous la voirie, regards difficiles d'accès. Nous commençons par chercher d'où vient le problème, parce qu'un débouchage au jugé sur un réseau collectif se refait dans les trois mois.`,
  ],
  periurbain: [
    `nous intervenons autant sur des maisons individuelles que sur des petits collectifs. En secteur pavillonnaire, les bouchons se forment le plus souvent sur le branchement entre la maison et le réseau public, à l'endroit où les racines et les graisses s'accumulent.`,
    `l'habitat est surtout pavillonnaire. Le point faible, c'est presque toujours le regard de visite ou le branchement sous le jardin : des années de graisses de cuisine et quelques racines d'arbre suffisent à réduire une canalisation de moitié sans que personne ne s'en aperçoive.`,
    `nous travaillons principalement sur des maisons avec jardin. Quand plusieurs évacuations se bouchent en même temps — évier, douche, WC —, le problème n'est pas dans la maison mais sur le collecteur extérieur. C'est exactement ce que l'hydrocurage traite.`,
  ],
  bourg: [
    `l'habitat est majoritairement individuel, avec des réseaux parfois anciens et, dans les secteurs non raccordés, des installations autonomes. Le passage caméra est souvent ce qui évite des travaux de terrassement inutiles.`,
    `on trouve des maisons anciennes et, à l'écart du bourg, des habitations en assainissement non collectif. Fosse, bac dégraisseur, épandage : chacun a son entretien, et un réseau négligé finit toujours par se rappeler au mauvais moment.`,
    `les canalisations sont souvent d'origine, en grès ou en fonte, avec des joints qui se déboîtent et laissent entrer les racines. Inspecter avant de creuser évite de défoncer une allée pour rien.`,
  ],
};

/** Choix stable : la même commune donne toujours la même variante. */
const idx = [...c.slug].reduce((n, ch) => n + ch.charCodeAt(0), 0);
const variante = variantes[c.tissu][idx % variantes[c.tissu].length];

/* À défaut de secteur, une phrase propre au bassin : chaque page garde ainsi
   une deuxième phrase qui lui est propre. */
const phraseBassin: Record<string, string> = {
  'Agglomération de Rouen': ` L'agglomération rouennaise mêle immeubles de centre-ville et lotissements : nous adaptons la méthode au réseau, pas l'inverse.`,
  'Agglomération du Havre': ` Près de l'estuaire, les réseaux travaillent avec une nappe haute et des sols instables, ce qui fatigue les joints et favorise les déboîtements.`,
  "Côte d'Albâtre": ` Sur le littoral, le sel et l'humidité accélèrent la corrosion des réseaux en fonte, et les fortes pluies saturent vite les collecteurs.`,
  'Estuaire et vallée du Commerce': ` Dans la vallée du Commerce, l'habitat ancien côtoie des zones d'activité : les contraintes ne sont pas les mêmes d'une rue à l'autre.`,
  'Pays de Caux intérieur': ` Sur le plateau cauchois, beaucoup d'habitations sont éloignées du réseau collectif et fonctionnent en assainissement autonome.`,
  'Pays de Bray': ` Le pays de Bray est un secteur argileux : les terrains bougent, et les canalisations enterrées avec eux.`,
  "Boucle d'Elbeuf": ` La boucle d'Elbeuf a un bâti ancien, avec des réseaux qui ont parfois plus d'un siècle et n'ont jamais été inspectés.`,
  "Agglomération d'Évreux": ` Dans la vallée de l'Iton, les réseaux reçoivent beaucoup d'eaux de ruissellement, ce qui entraîne limons et sables dans les collecteurs.`,
  'Vallée de Seine': ` Le long de la Seine, la nappe est proche de la surface : un réseau fissuré se remplit d'eau claire et s'ensable.`,
  "Ouest de l'Eure": ` Dans la vallée de la Risle et le Roumois, l'habitat est dispersé et souvent en assainissement non collectif.`,
  'Vexin normand': ` Le Vexin normand est rural : fosses, bacs dégraisseurs et longs branchements sous jardin y sont la règle.`,
  'Centre et sud de l\'Eure': ` Au centre et au sud du département, les bourgs sont distants et les installations souvent autonomes.`,
};

const phraseSecteur = {
  cailly: ` La vallée du Cailly est un secteur de fond de vallée : les réseaux y reçoivent aussi les eaux de ruissellement du plateau, ce qui accélère l'encrassement.`,
  'plateau-est': ` Sur le plateau est de Rouen, les maisons sont souvent raccordées par de longs branchements sous jardin, où les racines trouvent vite le chemin.`,
  'boucle-seine': ` Dans la boucle de Seine, la nappe est haute : un réseau fissuré se remplit d'eau claire et perd son pouvoir d'entraînement, ce qu'une caméra repère immédiatement.`,
  'rive-gauche': ``,
}[c.secteur ?? 'rive-gauche'] || phraseBassin[c.bassin] || '';

const contexte = `${ANom}, ${variante}${phraseSecteur}`;

const proches = (voisines(c).length ? voisines(c) : memeDepartement(c)).slice(0, 6);

const faq = [
  { q: `Combien coûte un débouchage ${aNom} ?`,
    a: `Un débouchage manuel est à ${eur(prixManuel)} HT, un débouchage à l'hydrocureur à ${eur(prixHydro)} HT, déplacement et première heure compris. ${c.nom} est ${libZone}.${c.zone === 'AB' ? ' Selon l\'adresse exacte, le tarif retenu est celui de la zone A ou de la zone B : nous vous le confirmons au téléphone, avant tout déplacement.' : ''} Le détail complet est sur notre <a href="/tarifs/">grille tarifaire</a>, majorations comprises. Le devis est gratuit.` },
  { q: `Intervenez-vous la nuit et le week-end ${aNom} ?`,
    a: `Oui, ${dispo}. Une majoration s'applique le samedi, en soirée, la nuit, le dimanche et les jours fériés : elle est <a href="/tarifs/">affichée au pourcentage près</a> et vous est annoncée au téléphone avant que nous partions. Aucun supplément n'apparaît sur la facture sans avoir été annoncé.` },
  { q: `Quel est le délai d'intervention ${aNom} ?`,
    a: c.zone === 'A'
      ? `${c.nom} est en zone A, à moins de 20 km de notre base : nous y sommes généralement <strong>en ${e.delaiZoneA}</strong>. Ce délai reste indicatif, il dépend de l'heure et de la position de nos équipes au moment de votre appel : nous vous le confirmons au téléphone, au ${tel}.`
      : `${c.nom} est en zone B, au-delà de 20 km de Rouen : le délai dépend de la route et de la position de nos équipes. Nous vous donnons une estimation honnête au téléphone, lors de l'appel, au ${tel}. Nous préférons annoncer un créneau tenable plutôt qu'une promesse qui ne le serait pas.` },
  { q: `Intervenez-vous pour les syndics et les professionnels ${deNom} ?`,
    a: `Oui. Copropriétés, bailleurs, commerces, restaurants et industries : colonnes, branchements, bacs à graisse, réseaux complets. Le passage caméra permet de garder une trace de l'état du réseau, et les photos vous sont remises sur clé USB. Voir la page <a href="/professionnels/">Professionnels et syndics</a>.` },
];

/* Google coupe autour de 60 caractères : pour les noms longs, on raccourcit
   plutôt que de laisser tronquer « | HYDROFLASH ». */
const titreLong = `Débouchage et assainissement ${aNom} (${c.cp}) | HYDROFLASH`;
const titrePage = titreLong.length <= 65 ? titreLong : `Débouchage ${aNom} (${c.cp}) | HYDROFLASH`;
/* La description est coupée vers 160 caractères : on garde l'essentiel en tête. */
const descLong = `Débouchage, curage, passage caméra et pompage ${aNom} (${c.cp}). Intervention ${dispo}, devis gratuit, à partir de ${eur(prixManuel)} HT.`;
const descPage = descLong.length <= 170 ? descLong : `Débouchage, curage et pompage ${aNom} (${c.cp}). ${dispo}, devis gratuit, à partir de ${eur(prixManuel)} HT.`;
---
<Base
  titre={titrePage}
  description={descPage}
  feuilles={[FEUILLE_CONTENU, { ordi: zonesOrdi, mobile: zonesMobile }]}
  jsonld={schemaEntreprise({ nom: c.nom, cp: c.cp, dep: c.dep })}
>
  <SousHero
    ariane={[{ label: "Zones d'intervention", href: '/zones-intervention/' }, { label: departement, href: pageDep }, { label: c.nom }]}
    surtitre={`${c.nom} · ${c.cp}`}
    titre={`Débouchage et assainissement`}
    titreFin={`${aNom}.`}
    intro={`Canalisation bouchée, réseau qui refoule, bac à graisse plein&nbsp;? Nous intervenons ${aNom} ${dispo}. <strong>Devis gratuit et tarif transparent</strong>&nbsp;: le prix vous est donné au téléphone, avant que nous partions.`}
    picto="zone"
  />

  <section class="sec sec-sm" aria-labelledby="t-ville">
    <div class="wrap c-grid2">
      <div>
        <p class="sec-label">{departement} · {c.bassin}</p>
        <h2 class="h2" id="t-ville">Nos interventions <em>{aNom}</em></h2>
        <div class="prose zprose">
          <p set:html={contexte} />
          <p>{c.population ? <>{c.nom} compte {hab}&nbsp;habitants et se situe</> : <>{c.nom} se situe</>} en <strong>{libZone}</strong> de notre grille tarifaire. Nous couvrons l'ensemble de <a href={pageDep}>{leDep}</a>, avec un seul numéro&nbsp;: <a class="tel" href={e.telephone.lien}>{e.telephone.affiche}</a>.</p>
        </div>
      </div>
      <dl class="kv">
        <dt>Commune</dt><dd>{c.nom} ({c.cp}), {departement}</dd>
        <dt>Zone tarifaire</dt><dd>{c.zone === 'AB' ? 'À la limite des zones A et B — confirmée au téléphone selon votre adresse' : `Zone ${c.zone}`}</dd>
        <dt>Débouchage manuel</dt><dd>à partir de {eur(prixManuel)} HT, déplacement et 1<sup>re</sup>&nbsp;heure compris</dd>
        <dt>Débouchage hydrocureur</dt><dd>à partir de {eur(prixHydro)} HT, déplacement et 1<sup>re</sup>&nbsp;heure compris</dd>
        <dt>Devis</dt><dd>Gratuit, sans engagement</dd>
        <dt>Délai d'intervention</dt><dd>{c.zone === 'A' ? `Généralement ${e.delaiZoneA}` : 'Estimé au téléphone, selon la route'}</dd>
        <dt>Disponibilité</dt><dd>{dispo}</dd>
      </dl>
    </div>
  </section>

  <section class="sec sec-sm bg-mist" aria-labelledby="t-prix">
    <div class="wrap c-grid2">
      <div>
        <p class="sec-label">Pas de mauvaise surprise</p>
        <h2 class="h2" id="t-prix">Le prix est dit <em>avant qu'on parte</em></h2>
        <p class="lead zh-lead">Vous n'avez pas à redouter le moment de la facture&nbsp;: tout est annoncé à l'avance, et tout est publié.</p>
      </div>
      <ul class="checks">
        <li><strong>Devis gratuit et sans engagement</strong>, par téléphone ou depuis le <a href="/contact/">formulaire</a>.</li>
        <li><strong>Le prix annoncé est le prix payé</strong>, dès lors que l'intervention correspond à ce que vous nous avez décrit.</li>
        <li><strong>Aucun frais caché.</strong> Déplacement et première heure sont compris dans le forfait.</li>
        <li><strong>Les majorations sont publiées</strong>, au pourcentage près&nbsp;: <a href="/tarifs/">voir la grille</a>.</li>
        <li><strong>Si nous découvrons autre chose sur place</strong>, nous vous le disons et vous donnons le nouveau prix. Rien ne démarre sans votre accord.</li>
      </ul>
    </div>
  </section>

  <section class="sec sec-sm" aria-labelledby="t-presta">
    <div class="wrap">
      <div class="c-head">
        <div><p class="sec-label">Prestations</p><h2 class="h2" id="t-presta">Ce que nous faisons <em>{aNom}</em></h2></div>
        <p class="lead">Du bouchon d'évier au curage d'un réseau complet, avec le même interlocuteur du premier appel à la fin du chantier.</p>
      </div>
      <ul class="cards cards-3">
        {services.map((s) => (
          <li class="li-c"><a class="card" href={s.url}>
            <span class="num">{s.numero}</span>
            <img src={`/img/pictos/${s.picto}-noir.svg`} alt="" width="48" height="48" loading="lazy" />
            <h3>{s.titre}</h3>
            <p>{s.resume}</p>
            <span class="go">Découvrir <svg class="ic" aria-hidden="true"><use href="#i-ar"/></svg></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={faq} titre={`Vos questions sur ${c.nom}`} label="Questions" />

  {proches.length > 0 && (
    <section class="sec sec-sm bg-mist" aria-labelledby="t-autour">
      <div class="wrap">
        <div class="c-head">
          <div><p class="sec-label">Autour {deNom}</p><h2 class="h2" id="t-autour">Nous intervenons aussi <em>à côté</em></h2></div>
        </div>
        <ul class="zb">
          {proches.map((v) => (
            <li class="zb-item"><a href={`/zones-intervention/${v.slug}-${v.cp}/`}>{v.nom}<span class="zb-pop">{v.cp}</span></a></li>
          ))}
        </ul>
        <p class="note">Votre commune n'est pas dans la liste&nbsp;? Nous couvrons toute <a href={pageDep}>{leDep}</a>. Vérifiez votre code postal sur la <a href="/zones-intervention/">page des zones d'intervention</a>.</p>
      </div>
    </section>
  )}

  <ContactCta
    titreD={`Une canalisation bouchée ${aNom} ?`}
    titreDem="Appelez, le devis est gratuit."
    titreM="Demandez votre devis."
  />
</Base>
