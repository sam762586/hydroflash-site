---
/* Contact : appel en premier (24 h/24 · 7 j/7, rappel immédiat), e-mail, zone, formulaire complet (#devis),
   encart « Ce qui se passe ensuite ». Les liens « Devis » du site pointent vers /contact/#devis.
   ?prestation=<slug> (ex. curage, passage-camera) présélectionne le type de problème (script facultatif). */
import Base from '../../layouts/Base.astro';
import SousHero from '../../components/SousHero.astro';
import FormulaireDemande from '../../components/FormulaireDemande.astro';
import Tbc from '../../components/Tbc.astro';
import { FEUILLE_CONTENU } from '../../lib/feuilles';
import { PROD } from '../../lib/env';
import { services } from '../../data/services';
import { entreprise as e } from '../../data/entreprise';
import { schemaEntreprise } from '../../lib/schema';
import contactOrdi from '../../styles/pages/contact-ordinateur.css?url';
import contactMobile from '../../styles/pages/contact-mobile.css?url';
/* Espaces insécables dans « 24 h/24 · 7 j/7 » (évite « 24 / h/24 » en fin de ligne). */
const dispo = e.disponibilite.libelle.replace(/(\d) /g, '$1\u00a0');
const dispoC = e.disponibilite.court.replace(/(\d) /g, '$1\u00a0');

/* Index des options du champ « Type de problème » (même ordre que FormulaireDemande : débouchage, puis services 2 à 6, puis Autre). */
const indexPrestation = Object.fromEntries(services.map((s, i) => [s.slug, i]));
---
<Base
  titre={`Contact et devis : ${e.telephone.affiche}, 24 h/24 | HYDROFLASH`}
  description={`Appelez HYDROFLASH au ${e.telephone.affiche}, ${dispo}, ou envoyez votre demande de devis : nous vous rappelons immédiatement.`}
  feuilles={[FEUILLE_CONTENU, { ordi: contactOrdi, mobile: contactMobile }]}
  jsonld={schemaEntreprise()}
>
  <SousHero
    ariane={[{ label: 'Contact' }]}
    surtitre={`Contact · ${dispoC}`}
    titre="Contact et devis"
    titreFin="Appelez, ou décrivez-nous votre problème."
    intro={`Le plus rapide&nbsp;: un appel, <strong>${dispo}</strong>. <strong>Devis gratuit et tarif transparent</strong>&nbsp;: vous connaissez le prix, majoration comprise, avant que nous partions. Vous préférez écrire&nbsp;? Envoyez votre demande&nbsp;: nous vous rappelons immédiatement.`}
    actions={false}
    compact
  />

  <section class="sec sec-sm ct-sec" aria-labelledby="t-appel">
    <div class="wrap ct-grid">
      <div class="ct-call">
        <p class="sec-label sec-label-nb">Le plus rapide</p>
        <h2 class="ct-h" id="t-appel">Appelez HYDROFLASH</h2>
        <a class="btn btn-call btn-xl ct-btn" href={e.telephone.lien}><span class="ic-round"><svg class="ic" aria-hidden="true"><use class="u-d" href="#i-tel"/><use class="u-m" href="#i-tel-f"/></svg></span><span class="btn-txt"><span class="l1">Appeler HYDROFLASH</span><span class="l2">{e.telephone.affiche}</span></span></a>
        <ul class="ct-pts">
          <li>Intervention {dispoC}</li>
          <li>Devis gratuit et tarif transparent</li>
          <li>Rappel immédiat après une demande écrite</li>
        </ul>
      </div>

      <div class="ct-infos">
        <h2 class="ct-h2" id="t-infos">Nos coordonnées</h2>
        <dl class="kv">
          <dt>Téléphone</dt><dd><a class="ct-a tel" href={e.telephone.lien}>{e.telephone.affiche}</a></dd>
          <dt>E-mail</dt><dd><a class="ct-a" href={`mailto:${e.email}`}>{e.email}</a></dd>
          <dt>Disponibilité</dt><dd>Intervention {dispo}&nbsp;; majoration le soir, le week-end et les jours fériés (<a href="/tarifs/">voir les tarifs</a>)</dd>
          <dt>Zone</dt><dd>{e.zone.libelle} — <a class="ct-a" href="/zones-intervention/">vérifier mon code postal</a></dd>
          {!PROD && !e.adresse && <><dt>Adresse</dt><dd><Tbc label="adresse de la base à confirmer" /></dd></>}
        </dl>
      </div>

      <div class="ct-form">
        <h2 class="ct-h2" id="t-ecrire">Par écrit&nbsp;: <span class="ct-h2b">devis ou rappel</span></h2>
        <p class="ct-form-l">Quelques informations suffisent. Une photo du problème nous aide à préparer l'intervention.</p>
        <FormulaireDemande id="devis" />
      </div>

      <aside class="ct-next" aria-labelledby="t-next">
        <h2 class="ct-h2" id="t-next">Ce qui se passe ensuite</h2>
        <ol class="ct-steps">
          <li><h3>Vous appelez ou envoyez votre demande</h3><p>Par téléphone, {dispo}, ou avec le formulaire de cette page.</p></li>
          <li><h3>Nous vous rappelons immédiatement</h3><p>Après une demande écrite, nous vous rappelons immédiatement pour faire le point sur le problème.</p></li>
          <li><h3>Nous organisons l'intervention</h3><p>Le devis est gratuit et sans engagement, et le tarif est transparent&nbsp;: majoration de soirée, de week-end ou de jour férié comprise, vous connaissez le prix avant que nous partions. Rien n'apparaît sur la facture sans avoir été dit. Sur Rouen et 20&nbsp;km autour, nous sommes généralement sur place en {e.delaiZoneA}&nbsp;; au-delà, une estimation vous est donnée au téléphone.</p></li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="sec sec-sm on-dark ct-urg" aria-labelledby="t-urg">
    <div class="wrap c-grid2">
      <div>
        <p class="sec-label">Urgence</p>
        <h2 class="h2" id="t-urg">Ça déborde, <em>l'eau remonte&nbsp;?</em></h2>
      </div>
      <div class="callout callout-o">
        <h3>Appelez maintenant, {dispoC}</h3>
        <p>Et retrouvez les bons gestes à adopter en attendant notre arrivée.</p>
        <div class="ct-urg-btns">
          <a class="btn btn-dark btn-xl" href={e.telephone.lien}><svg class="ic" aria-hidden="true"><use class="u-d" href="#i-tel"/><use class="u-m" href="#i-tel-f"/></svg>Appeler le {e.telephone.affiche}</a>
          <a class="btn btn-line btn-xl" href="/urgence-debouchage-24h/">Que faire en attendant&nbsp;?</a>
        </div>
      </div>
    </div>
  </section>

  {/* Présélection du type de problème depuis l'URL (?prestation=curage). Sans JavaScript : rien ne change. */}
  <script is:inline define:vars={{ indexPrestation }}>
    (function () {
      try {
        var p = new URLSearchParams(location.search).get('prestation');
        var sel = document.querySelector('#devis select[name="type"]');
        if (!p || !sel || !Object.prototype.hasOwnProperty.call(indexPrestation, p)) return;
        sel.selectedIndex = indexPrestation[p];
      } catch (e) { /* rien */ }
    })();
  </script>
</Base>
