---
/* Page Tarifs : grille publique HYDROFLASH (zones, majorations, prestations).
   Source unique : entreprise.tarifs. Aucun prix écrit en dur ici. */
import Base from '../../layouts/Base.astro';
import SousHero from '../../components/SousHero.astro';
import ContactCta from '../../components/ContactCta.astro';
import CalculateurPrix from '../../components/CalculateurPrix.astro';
import Preuves from '../../components/Preuves.astro';
import Tbc from '../../components/Tbc.astro';
import { FEUILLE_CONTENU, FEUILLE_BLOCS } from '../../lib/feuilles';
import tarifsOrdi from '../../styles/pages/tarifs-ordinateur.css?url';
import tarifsMobile from '../../styles/pages/tarifs-mobile.css?url';
import { entreprise as e } from '../../data/entreprise';
import { schemaEntreprise } from '../../lib/schema';
import { tauxParticulier, tvaReduiteActive, ttc, regleTva } from '../../lib/prix';

const FEUILLE_TARIFS = { ordi: tarifsOrdi, mobile: tarifsMobile };
const t = e.tarifs;
const coef = 1 + t.tvaPct / 100;
const premier = t.prestations[0];

/** 1 234,50 € — espace insécable fine avant l'euro, virgule décimale */
const eur = (v: number) =>
  v.toLocaleString('fr-FR', { minimumFractionDigits: v % 1 ? 2 : 0, maximumFractionDigits: 2 }) + ' €';

/** Regroupement par catégorie, dans l'ordre de la grille */
const categories: { nom: string; lignes: typeof t.prestations }[] = [];
for (const p of t.prestations) {
  const derniere = categories[categories.length - 1];
  if (derniere && derniere.nom === p.cat) derniere.lignes.push(p);
  else categories.push({ nom: p.cat, lignes: [p] });
}

const majorees = t.creneaux.filter((c) => c.maj > 0);
const majMax = Math.max(...majorees.map((c) => c.maj));

/* Exemple chiffré : débouchage à l'hydrocureur, zone A */
const exemple = t.prestations.find((p) => p.nom.includes('hydrocureur'))!;
const exSamedi = t.creneaux.find((c) => c.code === 'samedi')!;
const exDim = t.creneaux.find((c) => c.code === 'dim')!;
const diag = t.prestations.find((p) => p.nom.startsWith('Diagnostic'))!;
---
<Base
  titre="Tarifs débouchage, curage et pompage | HYDROFLASH"
  description={`Grille tarifaire HYDROFLASH : débouchage à partir de ${eur(ttc(premier.a!, tauxParticulier(premier)))} TTC, curage, caméra et pompage en Seine-Maritime et dans l'Eure. Zones et majorations publiées.`}
  feuilles={[FEUILLE_CONTENU, FEUILLE_TARIFS, FEUILLE_BLOCS]}
  jsonld={schemaEntreprise()}
>
  <SousHero
    ariane={[{ label: 'Tarifs' }]}
    surtitre={`Tarifs · ${t.prestations.length} prestations`}
    titre="Des prix affichés,"
    titreFin="clairs et transparents, majoration comprise."
    intro="Vous connaissez le prix avant notre départ. Chaque prestation a son tarif, qui varie selon deux critères seulement&nbsp;: la distance depuis Rouen et le moment de l'intervention. Aucune mauvaise surprise à l'arrivée."
    picto="devis"
  />

  <CalculateurPrix id="calc-tarifs" titre="Calculez votre prix," titreFin="en dix secondes." grilleHref="#t-grille" />

  <section class="sec sec-sm" aria-labelledby="t-zones">
    <div class="wrap">
      <div class="c-head">
        <div><p class="sec-label">Zones</p><h2 class="h2" id="t-zones">Deux zones, <em>deux tarifs</em></h2></div>
        <p class="lead">La zone est déterminée par l'adresse d'intervention. Nous vous la confirmons au téléphone.</p>
      </div>
      <ul class="tf-zones">
        {t.zones.map((z) => (
          <li class="tf-zone"><b>Zone {z.code}</b><span>{z.libelle}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec-sm" aria-labelledby="t-grille">
    <div class="wrap">
      <div class="c-head">
        <div><p class="sec-label">Grille</p><h2 class="h2" id="t-grille">Le prix de <em>chaque prestation</em></h2></div>
        <p class="lead">Prix pour une intervention en semaine entre 8&nbsp;h et 18&nbsp;h. En dehors de ce créneau, la majoration ci-dessous s'applique. Particulier ou professionnel&nbsp;: choisissez l'affichage qui vous concerne.</p>
      </div>

      <div class="vue">
      <div class="vue-bascule" role="radiogroup" aria-label="Affichage des prix">
        <label><input type="radio" name="vue" id="vue-part" value="part" checked><span>Particulier · TTC</span></label>
        <label><input type="radio" name="vue" id="vue-pro" value="pro"><span>Professionnel · HT</span></label>
      </div>
      <table class="tf-tab">
        <caption><span class="px-part">Grille tarifaire HYDROFLASH — prix TTC pour les particuliers (HT entre parenthèses)</span><span class="px-pro">Grille tarifaire HYDROFLASH — prix HT pour les professionnels (TTC à {t.tvaPct}&nbsp;% entre parenthèses)</span></caption>
        <thead>
          <tr>
            <th scope="col">Prestation</th>
            <th scope="col">Unité</th>
            <th scope="col">Zone A</th>
            <th scope="col">Zone B</th>
          </tr>
        </thead>
        <tbody>
          {categories.map((c) => (
            <>
              <tr class="tf-cat"><td colspan="4">{c.nom}</td></tr>
              {c.lignes.map((p) => (
                <tr>
                  <th scope="row">{p.nom}<span class="tf-d">{p.detail}</span></th>
                  <td class="tf-u">{p.unite}</td>
                  {[{ v: p.a, l: 'Zone A' }, { v: p.b, l: 'Zone B' }].map((z) => (
                    <td class="tf-p" data-l={z.l}>
                      {z.v === null ? 'Sur devis' : <>
                        <span class="px-part">{eur(ttc(z.v, tauxParticulier(p)))} TTC<span class="tf-ttc"> ({eur(z.v)} HT · TVA {tauxParticulier(p)}&nbsp;%)</span></span>
                        <span class="px-pro">{eur(z.v)} HT<span class="tf-ttc"> ({eur(Math.round(z.v * coef * 100) / 100)} TTC)</span></span>
                      </>}
                    </td>
                  ))}
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>

      <p class="note">{t.regleDemiHeure}</p>
      <p class="vue-note vue-note-part">{tvaReduiteActive
        ? <>{regleTva.conditions} {regleTva.justificatif} {regleTva.sinon} <a href="#tva">Les conditions en détail</a></>
        : <>Prix TTC avec la TVA à {t.tvaPct}&nbsp;%. <Tbc label={`TVA à ${t.tvaReduitePct} % pour les logements de plus de 2 ans : à confirmer par le comptable`} /></>}</p>
      <p class="vue-note vue-note-pro">{tvaReduiteActive
        ? <>Prix HT, TVA en sus. Débouchage, curage, détartrage et bacs à graisse&nbsp;: {t.tvaReduitePct}&nbsp;% dans des locaux d'habitation achevés depuis plus de deux ans (logements, parties communes d'immeubles d'habitation), {t.tvaPct}&nbsp;% dans les autres locaux. Autres prestations&nbsp;: {t.tvaPct}&nbsp;%. <a href="#tva">Les conditions en détail</a></>
        : <>Prix HT, TVA en sus au taux applicable à vos locaux.</>}</p>
      </div>
    </div>
  </section>

  <section class="sec sec-sm on-dark" aria-labelledby="t-maj">
    <div class="wrap c-grid2">
      <div>
        <p class="sec-label">Majorations</p>
        <h2 class="h2" id="t-maj">Le soir, la nuit, le week-end <em>et les jours fériés</em></h2>
        <p class="lead">Nous intervenons à toute heure, y compris à 2&nbsp;h du matin un dimanche. Une majoration s'applique alors au prix de votre zone, pour couvrir la mobilisation d'une équipe et d'un camion hors horaires habituels. Elle vous est toujours confirmée par téléphone, avant notre départ.</p>
      </div>
      <div>
        <table class="tf-maj">
          <caption class="sr">Majorations par créneau horaire</caption>
          <tbody>
            {t.creneaux.map((c) => (
              <tr><th scope="row">{c.libelle}</th><td>{c.maj === 0 ? 'Tarif de base' : `+ ${c.maj} %`}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sec sec-sm" aria-labelledby="t-ex">
    <div class="wrap">
      <div class="c-head">
        <div><p class="sec-label">Exemple</p><h2 class="h2" id="t-ex">Un cas concret, <em>du début à la fin</em></h2></div>
        <p class="lead">{exemple.nom}, en zone A ({t.zones[0].libelle}), déplacement et première heure inclus{tauxParticulier(exemple) === t.tvaReduitePct ? ', chez un particulier dont le logement a plus de deux ans' : ''}.</p>
      </div>
      <ul class="tf-ex">
        {[{ b: 'Mardi 14 h', maj: 0 }, { b: exSamedi.libelle, maj: exSamedi.maj }, { b: exDim.libelle, maj: exDim.maj }].map((x) => {
          const ht = Math.round(exemple.a! * (1 + x.maj / 100) * 100) / 100;
          return (
            <li>
              <b>{x.b}</b>
              <strong>{eur(ttc(ht, tauxParticulier(exemple)))} TTC</strong>
              <span>{x.maj ? `Majoration de ${x.maj} %` : 'Tarif de base'}, soit {eur(ht)} HT, TVA {tauxParticulier(exemple)}&nbsp;% comprise.</span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="sec sec-sm" aria-labelledby="t-faq">
    <div class="wrap">
      <div class="c-head">
        <div><p class="sec-label">Questions</p><h2 class="h2" id="t-faq">Ce qu'on <em>nous demande</em></h2></div>
      </div>
      <div class="faq">
        <details open>
          <summary><span class="q-n">Q.01</span>Le prix annoncé est-il le prix payé&nbsp;?<span class="tog" aria-hidden="true"></span></summary>
          <p class="ans">Oui, dès lors que l'intervention correspond à ce que vous nous avez décrit. Si nous découvrons sur place un problème d'une autre nature — un réseau effondré, un volume bien supérieur à ce qui était annoncé — nous vous le disons avant de continuer, et nous vous donnons le nouveau prix. Rien ne démarre sans votre accord.</p>
        </details>
        <details>
          <summary><span class="q-n">Q.02</span>Le déplacement est-il facturé en plus&nbsp;?<span class="tog" aria-hidden="true"></span></summary>
          <p class="ans">Non. Le déplacement et la première heure d'intervention sont compris dans les forfaits de débouchage. Si l'intervention s'avère impossible, seul le diagnostic est facturé, soit {eur(ttc(diag.a!, tauxParticulier(diag)))} TTC ({eur(diag.a!)} HT) en zone A&nbsp;; 30&nbsp;% de cette somme sont déduits de votre facture si nous intervenons dans les 30&nbsp;jours qui suivent.</p>
        </details>
        <details>
          <summary><span class="q-n">Q.03</span>Pourquoi un supplément la nuit et le week-end&nbsp;?<span class="tog" aria-hidden="true"></span></summary>
          <p class="ans">Parce qu'intervenir en dehors des heures ouvrées mobilise une équipe d'astreinte. La majoration est connue d'avance, affichée ci-dessus, et va de {majorees[0].maj}&nbsp;% à {majMax}&nbsp;% selon le créneau. Elle ne s'applique jamais rétroactivement&nbsp;: c'est l'heure de notre arrivée sur place qui fait foi.</p>
        </details>
        <details>
          <summary><span class="q-n">Q.04</span>Faites-vous des devis&nbsp;?<span class="tog" aria-hidden="true"></span></summary>
          <p class="ans">Oui, pour tout ce qui sort de la grille&nbsp;: détartrage, inspection de plus de 30&nbsp;ml, curage de réseau complet, contrats d'entretien pour les syndics et les professionnels. Décrivez-nous le réseau depuis la page <a href="/contact/">Contact</a> ou appelez-nous au <a class="tel" href={e.telephone.lien}>{e.telephone.affiche}</a>.</p>
        </details>
        {tvaReduiteActive && (
          <details id="tva">
            <summary><span class="q-n">Q.05</span>Pourquoi la TVA est-elle à {t.tvaReduitePct}&nbsp;% sur certaines lignes&nbsp;?<span class="tog" aria-hidden="true"></span></summary>
            <div class="ans prose">
              <p>Parce que la loi prévoit un taux réduit de {t.tvaReduitePct}&nbsp;% pour l'entretien des logements achevés depuis plus de deux&nbsp;ans (article 279-0 bis du code général des impôts). Il s'applique ici&nbsp;:</p>
              <ul>
                <li>au <strong>débouchage</strong>, au <strong>curage</strong>, au <strong>détartrage</strong> des canalisations et au <strong>nettoyage des bacs à graisse</strong>&nbsp;;</li>
                <li>dans un <strong>local d'habitation</strong> (maison, appartement, parties communes d'un immeuble d'habitation) <strong>achevé depuis plus de deux&nbsp;ans</strong>&nbsp;;</li>
                <li>que vous en soyez propriétaire, locataire, bailleur ou syndic&nbsp;: c'est le logement qui compte, pas le client.</li>
              </ul>
              <p>{regleTva.justificatif} Vous y confirmez que le logement est achevé depuis plus de deux&nbsp;ans et que l'intervention ne s'inscrit pas dans une construction neuve ni dans un agrandissement de plus de 10&nbsp;% de la surface. Gardez votre exemplaire.</p>
              <p>{regleTva.sinon}</p>
            </div>
          </details>
        )}
      </div>
    </div>
  </section>

  <Preuves />

  <ContactCta
    label="Devis"
    titreD={'Une question sur un tarif\u00a0?'}
    titreDem="Appelez-nous, nous vous répondons tout de suite."
    titreM="Demandez votre prix."
  />
</Base>
