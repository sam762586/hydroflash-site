---
/* À propos : uniquement des faits confirmés (data/entreprise.ts, CLAUDE.md).
   Histoire, équipe, chiffres, matériel détaillé : non confirmés → blocs visibles en préproduction seulement ({!PROD && …}). */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SousHero from '../components/SousHero.astro';
import ContactCta from '../components/ContactCta.astro';
import Tbc from '../components/Tbc.astro';
import { FEUILLE_CONTENU } from '../lib/feuilles';
import { PROD } from '../lib/env';
import { services } from '../data/services';
import { entreprise as e } from '../data/entreprise';
import { schemaEntreprise } from '../lib/schema';
import contactOrdi from '../styles/pages/contact-ordinateur.css?url';
import contactMobile from '../styles/pages/contact-mobile.css?url';
import vehiculeMarque from '../assets/photos/vehicule-marque-atelier.jpg';
import vehiculeLivraison from '../assets/photos/vehicule-livraison.webp';
/* Espaces insécables dans « 24 h/24 · 7 j/7 » (évite « 24 / h/24 » en fin de ligne). */
const dispo = e.disponibilite.libelle.replace(/(\d) /g, '$1\u00a0');
const f = e.fondateurs;
/** Du plus ancien au plus récent : l'expérience la plus longue en premier. */
const equipe = [...f.equipe].sort((x, y) => y.annees - x.annees);
const cumul = equipe.reduce((t, m) => t + m.annees, 0);
/** « 18, 17 et 4 ans » */
const detailAnnees = equipe.slice(0, -1).map((m) => m.annees).join(', ') + ' et ' + equipe[equipe.length - 1].annees + '\u00a0ans';
/** « SD », « JM » — initiales affichées tant qu'il n'y a pas de photo. */
const initiales = (nom: string) => nom.split(' ').map((m) => m[0]).join('');
---
<Base
  titre={`À propos : ${cumul} ans d'expérience en assainissement | HYDROFLASH`}
  description={`${f.nombre} professionnels de l'assainissement près de Rouen, ${cumul} ans d'expérience cumulée. Débouchage, curage et caméra en Seine-Maritime et dans l'Eure, ${dispo}.`}
  feuilles={[FEUILLE_CONTENU, { ordi: contactOrdi, mobile: contactMobile }]}
  jsonld={schemaEntreprise()}
>
  <SousHero
    ariane={[{ label: 'À propos' }]}
    surtitre={`À propos · ${cumul} ans d'expérience`}
    titre={`${cumul} ans de canalisations,`}
    titreFin="et trois associés qui descendent encore dedans."
    intro={`HYDROFLASH, ce n'est pas une enseigne qui sous-traite&nbsp;: ce sont ${f.nombre} professionnels du métier qui ont décidé de travailler pour eux. ${detailAnnees} passés sur le terrain, comme ${f.postes}. Quand vous appelez, vous tombez sur l'un de nous ${f.nombre}, jamais sur un centre d'appels.`}
    picto="technicien"
  />

  <section class="sec sec-xs" aria-label="HYDROFLASH en chiffres">
    <div class="wrap">
      <ul class="ap-stats">
        <li><b>{cumul}</b><span>ans d'expérience</span><em>à {f.nombre}&nbsp;: {detailAnnees}</em></li>
        <li><b>{f.nombre}</b><span>associés, zéro sous-traitant</span><em>2 sur le terrain, 1 au bureau</em></li>
        <li><b>24/7</b><span>jour, nuit et week-end</span><em>un seul numéro</em></li>
        <li><b>2</b><span>départements couverts</span><em>Seine-Maritime et Eure</em></li>
      </ul>
    </div>
  </section>

  <section class="sec sec-sm" aria-labelledby="t-qui">
    <div class="wrap c-grid2">
      <div>
        <p class="sec-label">Pourquoi HYDROFLASH</p>
        <h2 class="h2" id="t-qui">Trois parcours, <em>une même lassitude</em></h2>
        <div class="prose ap-prose">
          <p>Nous avons passé {detailAnnees} dans l'assainissement, comme {f.postes}, chez des employeurs qui envoyaient les équipes chez des bailleurs sociaux, des syndics, des entreprises et des particuliers.</p>
          <p>On y voit toujours les mêmes scènes&nbsp;: un client qui découvre le prix une fois le camion garé devant chez lui, une intervention bâclée qu'il faut refaire trois mois plus tard, un standard qui promet une heure d'arrivée que personne ne tiendra. <strong>Nous avons monté HYDROFLASH pour faire le contraire.</strong></p>
          <p>Même métier, mêmes machines, mêmes gestes — mais nos prix sont <a href="/tarifs/">affichés en ligne</a>, et vous avez toujours quelqu'un au bout du fil. Nous couvrons la <a href="/zones-intervention/seine-maritime-76/">Seine-Maritime (76)</a> et l'<a href="/zones-intervention/eure-27/">Eure (27)</a>, {dispo}.</p>
        </div>
      </div>
      <dl class="kv ap-kv">
        <dt>Expérience</dt><dd>{cumul}&nbsp;ans cumulés à {f.nombre}&nbsp;: {detailAnnees} dans l'assainissement</dd>
        <dt>Métier</dt><dd>Assainissement&nbsp;: débouchage, curage, détartrage, passage caméra, pompage, entretien des réseaux</dd>
        <dt>Zone</dt><dd>{e.zone.libelle}</dd>
        <dt>Disponibilité</dt><dd>Intervention {dispo}</dd>
        <dt>Nuit, week-end et jours fériés</dt><dd>Majoration appliquée et publiée (<a href="/tarifs/">voir les tarifs</a>)</dd>
        <dt>Téléphone</dt><dd><a class="tel" href={e.telephone.lien}>{e.telephone.affiche}</a></dd>
        <dt>E-mail</dt><dd><a href={`mailto:${e.email}`}>{e.email}</a></dd>
      </dl>
    </div>
  </section>

  <section class="sec sec-sm bg-mist" aria-labelledby="t-terrain">
    <div class="wrap c-grid2">
      <div>
        <p class="sec-label">Sur le terrain</p>
        <h2 class="h2" id="t-terrain">Une vraie connaissance <em>des chantiers</em></h2>
        <p class="lead ap-lead">Canalisation bouchée, colonne entartrée, réseau qui refoule, bac à graisse saturé&nbsp;: ces situations, nous les connaissons par cœur.</p>
      </div>
      <ul class="checks">
        <li><strong>Le bon diagnostic</strong> dès la première visite.</li>
        <li><strong>La méthode adaptée</strong>, sans prestation inutile.</li>
        <li><strong>Une explication claire</strong> de l'origine du problème et de la solution.</li>
        <li><strong>Une intervention rapide</strong>, en sécurité et proprement.</li>
      </ul>
    </div>
  </section>

  <section class="sec sec-sm" aria-labelledby="t-inter">
    <div class="wrap">
      <div class="c-head">
        <div><p class="sec-label">La différence</p><h2 class="h2" id="t-inter">Ce qui change, <em>concrètement</em></h2></div>
        <p class="lead">Quatre situations que vous avez peut-être déjà vécues avec un dépanneur, et ce qui se passe chez nous.</p>
      </div>
      <table class="ap-vs">
        <thead>
          <tr><th scope="col" class="vs-a">Ce qu'on voit trop souvent</th><th scope="col" class="vs-b">Chez HYDROFLASH</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="vs-a">Le prix annoncé une fois le camion garé devant chez vous.</td>
            <td class="vs-b"><strong>Le prix au téléphone</strong>, avant qu'on démarre, et une <a href="/tarifs/">grille publiée en ligne</a>.</td>
          </tr>
          <tr>
            <td class="vs-a">Un standard qui note votre adresse et envoie un sous-traitant que personne ne connaît.</td>
            <td class="vs-b"><strong>Souad prend votre appel, Samuel ou Julien se déplace.</strong> Aucune plateforme, aucune sous-traitance.</td>
          </tr>
          <tr>
            <td class="vs-a">Un coup de furet, et le bouchon qui revient trois mois plus tard.</td>
            <td class="vs-b"><strong>On cherche la cause</strong>, au besoin à la caméra, pour que ça ne recommence pas.</td>
          </tr>
          <tr>
            <td class="vs-a">Une majoration de nuit découverte sur la facture.</td>
            <td class="vs-b"><strong>Les majorations sont affichées</strong>, au pourcentage près&nbsp;: soir, week-end et jours fériés.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="sec sec-sm bg-mist" aria-labelledby="t-eq">
    <div class="wrap">
      <div class="c-head">
        <div><p class="sec-label">L'équipe</p><h2 class="h2" id="t-eq">Les {f.nombre} personnes <em>que vous aurez au bout du fil</em></h2></div>
        <p class="lead">Pas de standard, pas de commercial&nbsp;: Souad prend les appels et établit les devis, Samuel et Julien sont sur le terrain.</p>
      </div>
      <ul class="ap-eq">
        {equipe.map((m) => (
          <li>
            <span class="eq-av" aria-hidden="true">{initiales(m.nom)}</span>
            <h3>{m.nom}</h3>
            <p class="eq-poste">{m.poste}</p>
            <p class="eq-ans"><b>{m.annees}</b> ans dans l'assainissement</p>
          </li>
        ))}
      </ul>
      <p class="note">À eux {f.nombre}, {cumul}&nbsp;ans de réseaux, de colonnes et de bacs à graisse en Normandie.</p>
    </div>
  </section>

  {!PROD && (
    <section class="sec sec-sm ap-tbc" aria-labelledby="t-hist">
      <div class="wrap">
        <div class="c-head">
          <div><p class="sec-label">Préproduction uniquement</p><h2 class="h2" id="t-hist">Histoire, équipe <em>et chiffres</em></h2></div>
          <p class="lead">Ces informations ne sont pas encore confirmées par HYDROFLASH&nbsp;: ce bloc n'apparaît pas sur le site en ligne.</p>
        </div>
        <dl class="kv">
          <dt>Histoire</dt><dd>Année de création <Tbc /></dd>
          <dt>Photo de l'équipe</dt><dd>Une photo des {f.nombre} associés devant le véhicule, pour remplacer les initiales <Tbc /></dd>
          <dt>Qualifications</dt><dd>Formations et habilitations (CATEC, etc.) <Tbc /></dd>
          <dt>Chiffres clés</dt><dd>Nombre d'interventions, de clients <Tbc /></dd>
          <dt>Matériel</dt><dd>Hydrocureuse haute pression, caméra d'inspection, pompage (modèles, capacités) <Tbc /></dd>
          <dt>Base d'intervention</dt><dd>Adresse de la base ou du dépôt <Tbc /></dd>
          <dt>Entreprise</dt><dd>Raison sociale, SIRET, assurance responsabilité civile professionnelle <Tbc /></dd>
        </dl>
      </div>
    </section>
  )}

  <section class="sec sec-sm" aria-labelledby="t-presta">
    <div class="wrap">
      <div class="c-head">
        <div><p class="sec-label">Prestations</p><h2 class="h2" id="t-presta">Six prestations, <em>un interlocuteur</em></h2></div>
        <p class="lead">Du bouchon d'évier au réseau d'une copropriété&nbsp;: nous identifions l'origine du problème et choisissons la technique adaptée.</p>
      </div>
      <ul class="cards cards-3">
        {services.map((s) => (
          <li class="li-c"><a class="card" href={s.url}>
            <span class="num">{s.numero}</span>
            <img src={`/img/pictos/${s.picto}-noir.svg`} alt="" width="48" height="48" loading="lazy" />
            <h3>{s.titre}</h3>
            <p>{s.resume}</p>
            <span class="go">Découvrir <svg class="ic" aria-hidden="true"><use href="#i-ar"/></svg></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec-sm on-dark" aria-labelledby="t-veh">
    <div class="wrap c-grid2 is-rev ap-veh">
      <div>
        <p class="sec-label">Véhicule d'intervention</p>
        <h2 class="h2" id="t-veh">Un véhicule <em>reconnaissable</em></h2>
        <div class="prose ap-prose">
          <p>Notre véhicule d'intervention est un pick-up à cabine simple, équipé d'un caisson à compartiments, de couleur orange (RAL&nbsp;2009, orange signalisation).</p>
          <p>Son marquage est à venir&nbsp;: le logo HYDROFLASH, le numéro <span class="tel">{e.telephone.affiche}</span>, la mention «&nbsp;Intervention 24h/24 · 7j/7&nbsp;» et nos prestations&nbsp;: débouchage, curage, détartrage, passage caméra, pompage.</p>
        </div>
      </div>
      <div class="ap-imgs">
        <div class="media">
          <figure>
            <Image src={vehiculeMarque} alt={`Pick-up HYDROFLASH orange à caisson : logo, numéro ${e.telephone.affiche}, mention « Intervention 24h/24 · 7j/7 » et liste des prestations sur le flanc.`} widths={[600, 900, 1300, 1740]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 90vw, 760px" loading="lazy" />
            <figcaption>Véhicule HYDROFLASH — visuel du marquage à venir</figcaption>
          </figure>
        </div>
        <figure class="ap-small">
          <Image src={vehiculeLivraison} alt="Le pick-up HYDROFLASH orange à caisson, photographié avant la pose du marquage." widths={[460, 915]} sizes="(max-width: 700px) 100vw, 400px" loading="lazy" />
          <figcaption>Photo réelle — le véhicule avant marquage</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="sec sec-sm bg-mist" aria-labelledby="t-eng">
    <div class="wrap c-grid2">
      <div>
        <p class="sec-label">Engagements</p>
        <h2 class="h2" id="t-eng">Ce sur quoi <em>vous pouvez compter</em></h2>
        <p class="lead ap-lead">Cinq engagements que vous pouvez vérifier avant même de nous appeler. Le délai d'intervention, lui, vous est donné au téléphone, selon votre adresse.</p>
      </div>
      <ul class="checks">
        <li><strong>Nos prix sont publics.</strong> La <a href="/tarifs/">grille complète</a> est en ligne, majorations comprises. Vous savez ce que vous payez avant de décrocher.</li>
        <li><strong>Devis gratuit et tarif transparent</strong>&nbsp;: le prix vous est donné avant que nous partions, et il ne bouge pas en arrivant.</li>
        <li><strong>Intervention {dispo}</strong>, la nuit comme le week-end, avec un seul numéro&nbsp;: <a class="tel" href={e.telephone.lien}>{e.telephone.affiche}</a>.</li>
        <li><strong>Rappel immédiat</strong> après une demande envoyée depuis le site.</li>
        <li><strong>Passage caméra</strong>&nbsp;: les photos de l'inspection vous sont remises sur clé USB, pas gardées par l'entreprise.</li>
      </ul>
    </div>
  </section>

  <ContactCta />
</Base>
