---
/** Formulaire de demande (rappel / devis). Envoi : /envoi-demande.php (script serveur, voir server/).
 *  Anti-spam : champ piège (site_web) + horodatage (t0). En préproduction : envoi simulé (data-preprod). */
import { PROD } from '../lib/env';
import { services } from '../data/services';
import { entreprise as e } from '../data/entreprise';
interface Props { id?: string; titre?: string; titreMobile?: string; complet?: boolean; prestation?: string; classe?: string }
const { id = 'devis', titre = 'Demande de devis', titreMobile = 'Être rappelé', complet = true, prestation, classe = 'form' } = Astro.props;
const types = [...services.map((s) => s.typeFormulaire ?? s.court), 'Autre'];
---
<form class={classe} id={id} method="post" action="/envoi-demande.php" enctype="multipart/form-data" aria-labelledby={`${id}-t`} data-demande data-preprod={PROD ? undefined : ''} novalidate>
  <h3 id={`${id}-t`}><span class="d-only">{titre}</span><span class="m-only">{titreMobile}</span></h3>
  <label class="fld"><span>Nom</span><input type="text" name="nom" autocomplete="name" placeholder="Votre nom" required maxlength="80"></label>
  <label class="fld"><span>Téléphone</span><input type="tel" name="tel" autocomplete="tel" inputmode="tel" placeholder="06 00 00 00 00" required maxlength="20"></label>
  {complet && (
    <>
      <div class="row2">
        <label class="fld"><span>Code postal</span><input type="text" name="cp" inputmode="numeric" autocomplete="postal-code" placeholder="76000" maxlength="5" pattern="[0-9]{5}"></label>
        <label class="fld"><span>Type de problème</span><select name="type">{types.map((t) => <option selected={t === prestation}>{t}</option>)}</select></label>
      </div>
      <label class="drop drop--photo"><svg class="ic" aria-hidden="true"><use href="#i-cam"/></svg><span><b>Ajoutez une photo</b>&nbsp;: elle nous aide à vous annoncer le bon prix <i>(facultatif · JPEG, PNG ou WebP · 8&nbsp;Mo max.)</i></span><input class="sr" type="file" name="photo" accept="image/jpeg,image/png,image/webp"></label>
      <details class="more" data-more>
        <summary><span>Ajouter un message <i>(facultatif)</i></span><span class="tog" aria-hidden="true"></span></summary>
        <div class="more-in">
          <label class="fld"><span>Message <i>(facultatif)</i></span><textarea name="message" maxlength="2000" placeholder="Décrivez la situation en quelques mots"></textarea></label>
        </div>
      </details>
    </>
  )}
  <div class="hp" aria-hidden="true"><label>Ne pas remplir<input type="text" name="site_web" tabindex="-1" autocomplete="off"></label></div>
  <input type="hidden" name="t0" value="">
  <input type="hidden" name="origine" value={Astro.url.pathname}>
  <p class="form-rappel"><svg class="ic" aria-hidden="true"><use href="#i-cb"/></svg><span>Rappel {e.rappel}, {e.disponibilite.court}</span></p>
  <button class="btn btn-call" type="submit"><span class="d-only">{complet ? 'Envoyer ma demande' : 'Me rappeler'}</span><span class="m-only">Me rappeler</span> <svg class="ic d-only" aria-hidden="true"><use href="#i-ar"/></svg></button>
  <p class="form-msg" data-form-msg tabindex="-1" role="status" aria-live="polite"></p>
  <p class="rgpd">Vos informations servent uniquement à traiter votre demande. <a href="/confidentialite/">Politique de confidentialité</a></p>
</form>
